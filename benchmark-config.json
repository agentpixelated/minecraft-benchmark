{
  "minecraft_version": "26.2",
  "base_mods": ["fabric-api", "sodium"],
  "optional_mods": [
    "immediatelyfast",
    "entityculling",
    "moreculling",
    "lithium",
    "ferrite-core",
    "c2me-fabric",
    "badoptimizations",
    "better-block-entities"
  ],
  "mod_labels": {
    "immediatelyfast": "ImmediatelyFast",
    "entityculling": "EntityCulling",
    "moreculling": "MoreCulling",
    "lithium": "Lithium",
    "ferrite-core": "FerriteCore",
    "c2me-fabric": "C2ME",
    "badoptimizations": "BadOptimizations",
    "better-block-entities": "Better Block Entities",
    "superresolution": "Super Resolution"
  },
  "suites": {
    "renderer_fps": {
      "label": "Renderer / FPS",
      "kind": "frametime",
      "scenes": ["geometry_transparency", "occlusion_entities"],
      "primary_metric": "mean_fps"
    },
    "particle": {
      "label": "Particle",
      "kind": "frametime",
      "scenes": ["particle_stress"],
      "primary_metric": "mean_fps"
    },
    "block_entity": {
      "label": "Block Entity",
      "kind": "frametime",
      "scenes": ["mixed_block_entities"],
      "primary_metric": "mean_fps"
    },
    "chunk_generation": {
      "label": "Chunk Generation",
      "kind": "streaming_frametime_proxy",
      "scenes": ["chunk_generation"],
      "primary_metric": "mean_fps",
      "note": "Measures client frametime while traversing virgin chunks; dedicated chunks/sec instrumentation is a future refinement."
    },
    "lighting": {
      "label": "Lighting",
      "kind": "frametime",
      "scenes": ["lighting_updates"],
      "primary_metric": "mean_fps"
    },
    "memory": {
      "label": "Memory",
      "kind": "process_rss",
      "primary_metric": "peak_rss_mb"
    },
    "network": {
      "label": "Network",
      "kind": "loopback_update_stress",
      "scenes": ["network_updates"],
      "primary_metric": "mean_fps",
      "note": "Integrated-server loopback update stress; this is not internet latency/throughput."
    },
    "super_resolution": {
      "label": "Render Scale + Super Resolution",
      "kind": "special_super_resolution",
      "scenes": ["geometry_transparency", "occlusion_entities", "mixed_block_entities"],
      "primary_metric": "mean_fps",
      "note": "Dedicated OpenGL-only cross-product of internal render scale and upscaling algorithm. Minecraft 26.2 Super Resolution builds disable their upscaling features on the native Vulkan backend."
    },
    "save_quit": {
      "label": "Save / Quit",
      "kind": "planned",
      "primary_metric": "save_quit_ms",
      "note": "Reserved in the result schema; true graceful save/quit timing will be added separately rather than using forced process cleanup."
    }
  },
  "super_resolution_benchmark": {
    "mod": "superresolution",
    "backend": "opengl",
    "sharpness": 0.55,
    "render_scales": [1.0, 0.75, 0.6666666667, 0.5882352941, 0.5],
    "algorithms": [
      {"id": "fsr1", "label": "FSR 1", "algorithm": "fsr1"},
      {"id": "sgsr1", "label": "SGSR 1", "algorithm": "sgsr1"},
      {"id": "sgsr2", "label": "SGSR 2", "algorithm": "sgsr2"},
      {"id": "fsr2", "label": "FSR 2 OpenGL", "algorithm": "fsr2", "hardware_optional": true},
      {"id": "fsr_v2", "label": "FidelityFX FSR 2.3.3", "algorithm": "fsr", "fsr_version": "V2", "hardware_optional": true},
      {"id": "fsr_v3", "label": "FidelityFX FSR 3.1.4", "algorithm": "fsr", "fsr_version": "V3", "hardware_optional": true},
      {"id": "xess", "label": "XeSS", "algorithm": "xess", "hardware_optional": true},
      {"id": "dlss", "label": "DLSS", "algorithm": "dlss", "hardware_optional": true}
    ],
    "profiles": [
      {"id": "sr_fsr1_quality", "legacy_alias": true},
      {"id": "sr_sgsr1_quality", "legacy_alias": true},
      {"id": "sr_fsr1_performance", "legacy_alias": true}
    ]
  },
  "window": {"width": 960, "height": 540},
  "video": {
    "render_distance": 10,
    "simulation_distance": 8,
    "max_fps": 260,
    "graphics_mode": 1,
    "mipmap_levels": 2,
    "entity_distance_scaling": 1.0,
    "clouds": false,
    "vsync": false
  },
  "benchmark": {
    "initial_seconds": 8,
    "warmup_seconds": 3,
    "measure_seconds": 8,
    "repeats_per_backend": 2,
    "cooldown_seconds": 2,
    "backend_proof_timeout_seconds": 90,
    "result_timeout_seconds": 150
  },
  "configs": [
    {"id": "sodium", "label": "Sodium only", "mods": []},
    {"id": "sodium_immediatelyfast", "label": "Sodium + ImmediatelyFast", "mods": ["immediatelyfast"]},
    {"id": "sodium_entityculling", "label": "Sodium + EntityCulling", "mods": ["entityculling"]},
    {"id": "sodium_moreculling", "label": "Sodium + MoreCulling", "mods": ["moreculling"]},
    {"id": "sodium_lithium", "label": "Sodium + Lithium", "mods": ["lithium"]},
    {"id": "sodium_ferritecore", "label": "Sodium + FerriteCore", "mods": ["ferrite-core"]},
    {"id": "sodium_badoptimizations", "label": "Sodium + BadOptimizations", "mods": ["badoptimizations"]},
    {"id": "sodium_bbe", "label": "Sodium + Better Block Entities", "mods": ["better-block-entities"]},
    {"id": "sodium_c2me", "label": "Sodium + C2ME", "mods": ["c2me-fabric"]},
    {"id": "sodium_if_mc", "label": "Sodium + ImmediatelyFast + MoreCulling", "mods": ["immediatelyfast", "moreculling"]},
    {"id": "sodium_if_lithium", "label": "Sodium + ImmediatelyFast + Lithium", "mods": ["immediatelyfast", "lithium"]},
    {"id": "sodium_mc_lithium", "label": "Sodium + MoreCulling + Lithium", "mods": ["moreculling", "lithium"]},
    {"id": "sodium_if_mc_lithium", "label": "Sodium + ImmediatelyFast + MoreCulling + Lithium", "mods": ["immediatelyfast", "moreculling", "lithium"]},
    {"id": "sodium_ec_mc_lithium", "label": "Sodium + EntityCulling + MoreCulling + Lithium", "mods": ["entityculling", "moreculling", "lithium"]},
    {"id": "sodium_full_no_c2me", "label": "Full stack without C2ME", "mods": ["immediatelyfast", "entityculling", "moreculling", "lithium", "ferrite-core"]},
    {"id": "sodium_full", "label": "Full stack", "mods": ["immediatelyfast", "entityculling", "moreculling", "lithium", "ferrite-core", "c2me-fabric"]}
  ]
}
